    "def validate_columns(df, expected_columns):\n",
    "    \"\"\"Checks every expected column is present and reports any extra ones.\"\"\"\n",
    "    # Columns we expected but which are not in the data\n",
    "    missing = [c for c in expected_columns if c not in df.columns]\n",
    "    # Columns in the data that we did not expect\n",
    "    extra = [c for c in df.columns if c not in expected_columns]\n",
    "\n",
    "    if missing:\n",
    "        print(\"Missing columns:\", missing)\n",
    "    else:\n",
    "        print(\"All\", len(expected_columns), \"expected columns are present.\")\n",
    "    print(\"Extra columns:\", extra if extra else \"none\")\n",
    "\n",
    "    # Returns True only if nothing is missing\n",
    "    return len(missing) == 0\n",
    "\n",
    "\n",
    "def summarize_missingness(df):\n",
    "    \"\"\"Returns the null count and null percentage for every column.\"\"\"\n",
    "    summary = pd.DataFrame({\n",
    "        # isnull() marks each empty cell as True; sum() counts the Trues per column\n",
    "        \"null_count\": df.isnull().sum(),\n",
    "        # mean() of True/False gives the fraction that is True; x100 for a percentage\n",
    "        \"null_pct\": (df.isnull().mean() * 100).round(2),\n",
    "    })\n",
    "    # Put the columns with the most missing values at the top\n",
    "    return summary.sort_values(\"null_count\", ascending=False)\n",
    "\n",
    "\n",
    "def check_range(df, column, low, high):\n",
    "    \"\"\"Counts values outside the valid range [low, high].\"\"\"\n",
    "    # Keep only the rows where the value is below low OR above high\n",
    "    outside = df[(df[column] < low) | (df[column] > high)]\n",
    "    return len(outside)"
   ]
  },
