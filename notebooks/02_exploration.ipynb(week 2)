    "# pandas is used for loading and analysing tables; matplotlib for charts\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Relative path: \"..\" means \"go up one folder\" from notebooks/ to the project folder,\n",
    "# so this works on any teammate's computer, not just one person's C: drive\n",
    "RAW_PATH = \"../data/raw/star_classification.csv\"\n",
    "\n",
    "# obj_ID and spec_obj_ID are 19-digit numbers. If pandas reads them as numbers\n",
    "# it stores them as float64, which only keeps about 16 digits, so different IDs\n",
    "# would get rounded to the same value. Reading them as text (str) keeps them exact.\n",
    "df = pd.read_csv(RAW_PATH, dtype={\"obj_ID\": str, \"spec_obj_ID\": str})\n",
    "print(\"Loaded\", RAW_PATH)"
   ]
  },
